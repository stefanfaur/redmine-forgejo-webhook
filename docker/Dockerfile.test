# syntax=docker/dockerfile:1.4
FROM ruby:3.1-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    REDMINE_VERSION=5.1.3 \
    LANG=C.UTF-8 \
    BUNDLE_WITHOUT=development \
    RAILS_ENV=test \
    RUBYOPT=-rlogger

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential \
        libsqlite3-dev \
        libssl-dev \
        libffi-dev \
        libxml2-dev \
        libxslt1-dev \
        zlib1g-dev \
        git \
        ca-certificates \
        imagemagick \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /redmine
RUN git clone --depth 1 --branch ${REDMINE_VERSION} https://github.com/redmine/redmine.git . \
 && rm -rf .git

# Minimal SQLite test DB config
RUN cat > config/database.yml <<'YAML'
test:
  adapter: sqlite3
  database: db/test.sqlite3
  timeout: 5000
YAML

# Stub config files Redmine expects to exist
RUN cp config/configuration.yml.example config/configuration.yml \
 && cp config/settings.yml config/settings.yml.orig

# Install gems including test group
RUN bundle config set --local without 'development' \
 && bundle install --jobs $(nproc)

# Plugin will be bind-mounted at /plugin at runtime
ENV PLUGIN_NAME=redmine_forgejo_webhook
WORKDIR /redmine

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["entrypoint.sh"]
CMD ["test"]
